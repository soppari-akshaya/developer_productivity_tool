# Flask Configuration
SECRET_KEY=dev-productivity-super-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration (SQLite)
DATABASE_URI=sqlite:///instance/developer_productivity.db

# Firebase Public Configuration (Frontend)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=developer-productivity-t-73574.firebaseapp.com
FIREBASE_PROJECT_ID=developer-productivity-t-73574
FIREBASE_STORAGE_BUCKET=developer-productivity-t-73574.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# Firebase Admin SDK Configuration (Backend)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# GitHub OAuth Integration (Optional Backend API Access)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# xAI Grok API Configuration (AI Productivity Assistant)
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
